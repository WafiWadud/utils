#!/usr/bin/env bash

set -eu

# Requires Bash 4.0 or higher for associative arrays
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
  echo "Error: Bash 4.0+ is required." >&2
  exit 1
fi

# Associative array to keep track of processed libraries (prevents infinite loops)
declare -A SEEN=()
# Regular array to hold the final list of paths
DEPENDENCIES=()

resolve_deps() {
  local target="$1"

  # 1. Base cases: Skip if empty, already processed, or doesn't exist as a file
  if [[ -z "$target" || -n "${SEEN[$target]}" || ! -f "$target" ]]; then
    return
  fi

  # 2. Mark as seen IMMEDIATELY to prevent circular dependency loops
  SEEN["$target"]=1

  # 3. Run ldd and parse the output
  # ldd output generally looks like one of these:
  #   libfoo.so.1 => /lib/x86_64-linux-gnu/libfoo.so.1 (0x00007f...)
  #   /lib64/ld-linux-x86-64.so.2 (0x00007f...)
  #   linux-vdso.so.1 (0x00007fff...)  <-- Virtual, no path, we ignore these
  local deps
  deps=$(ldd "$target" 2>/dev/null | awk '
    {
      path = ""
      # If the 2nd column is "=>", the path is in the 3rd column
      if ($2 == "=>") {
        path = $3
      } 
      # If there is no "=>", check if the 1st column is an absolute path
      else if ($1 ~ /^\//) {
        path = $1
      } 
      # Otherwise its a virtual library (like linux-vdso), skip it
      else {
        next
      }
      # Strip the trailing memory address " (0x0000...)"
      sub(/ \(0x.*/, "", path)
      print path
    }
  ')

  # If ldd failed or it's a static binary, deps will be empty
  if [[ -z "$deps" ]]; then
    return
  fi

  # 4. Iterate through the found paths and recurse
  while IFS= read -r dep; do
    if [[ -n "$dep" && -f "$dep" ]]; then
      DEPENDENCIES+=("$dep")
      # RECURSIVE CALL
      resolve_deps "$dep"
    fi
  done <<<"$deps"
}

# --- Main Execution ---

main() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: $0 <binary> [binary2 ...]" >&2
    exit 1
  fi

  for binary in "$@"; do
    if [[ ! -f "$binary" ]]; then
      echo "Warning: Cannot find '$binary', skipping." >&2
      continue
    fi

    # Start the recursive loop
    resolve_deps "$binary"
  done

  # Print unique, sorted list of all dependencies
  # We use printf '%s\n' to safely handle file paths that might contain spaces
  printf '%s depends on:\n' "$binary"
  printf '\t%s\n' "${DEPENDENCIES[@]}" | sort -u
}

main "$@"
